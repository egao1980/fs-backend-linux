(in-package #:fs-backend-linux/tests)

;;; Real reflinks, on each directory of FS_BACKEND_LINUX_REFLINK_DIRS (CI job
;;; `reflink`: a btrfs and an XFS reflink=1 loop volume). Elsewhere each test
;;; is one SKIP, or a FAILURE with FS_BACKEND_LINUX_REQUIRE_REFLINK=1.
;;; FILE-EXTENTS-SHARED-P (FIEMAP_EXTENT_SHARED) proves the ioctl reflinked:
;;; equal content alone would not tell a clone from a copy.

(defparameter +big-size+ (* 16 1024 1024))
(defparameter +old-mtime+ (encode-universal-time 0 0 12 1 6 2001 0))

(defun make-big-file (root rel &key (mode #o640) (seed 7))
  "A 16 MiB pseudo-random file at ROOT/REL with MODE and an old mtime; → its pathname."
  (let ((p (native (sub root rel))))
    (write-octets p (pseudo-random-octets +big-size+ seed))
    (chmod p mode)
    (pathlib:fs-set-mtime (local-fs) p +old-mtime+)
    p))

(defreflink ficlone-reflink-detected (dir)
  (let ((fs (local-fs)))
    (with-volume-scratch (root dir)
      (put root "src/a.txt" "alpha")
      (let ((src (native-dir (sub root "src" :directory t)))
            (here (native-dir root)))
        (ok (eq t (ficlone-available-p fs src here)) "the probe clone works")
        (ok (null (probe-leftovers here)) "no probe file left")
        (ok (eq :ficlone (pathlib:fs-clone-supported-p fs src here)))
        (ok (eq :ficlone (first (pathlib:clone-mechanisms fs src here))) "best available")
        (ok (eq t (ficlone-available-p fs (native-dir (mkdirs root "empty")) here))
            "the destination-only probe too")))))

(defreflink ficlone-reflink-16mib (dir)
  (let ((fs (local-fs)))
    (with-volume-scratch (root dir)
      (let* ((src (make-big-file root "src/big.bin"))
             (src-hash (file-hash src))
             (dst (native (sub root "clone/big.bin")))
             (cpy (native (sub root "copy/big.bin")))
             (r (pathlib:fs-clone-file fs src dst :mechanism :ficlone)))
        (testing "the report"
          (ok (eq :ficlone (pathlib:clone-report-mechanism r)))
          (ok (null (pathlib:clone-report-reason r)))
          (ok (eql 1 (pathlib:clone-report-cloned r)))
          (ok (eql 0 (pathlib:clone-report-copied r)))
          (ok (null (pathlib:clone-report-fallbacks r))))
        (testing "content and metadata"
          (ok (equal src-hash (file-hash dst)))
          (ok (eql +big-size+ (with-open-file (s dst :element-type '(unsigned-byte 8)) (file-length s))))
          (ok (eql #o640 (file-mode dst)) "mode")
          (ok (eql +old-mtime+ (file-write-date dst)) "mtime"))
        (testing "FIEMAP: the clone shares every extent, a copy shares none"
          (ok (file-extents-shared-p dst) "clone: FIEMAP_EXTENT_SHARED on every extent")
          (ok (file-extents-shared-p src) "source: shared with the clone")
          (pathlib:fs-clone-file fs src cpy :mechanism :copy)
          (ok (equal src-hash (file-hash cpy)))
          (ok (not (file-extents-shared-p cpy)) ":copy writes its own extents"))
        (testing "independence: an in-place write to the clone"
          (overwrite-in-place dst (* 5 1024 1024) (make-array 4096 :element-type '(unsigned-byte 8)
                                                                   :initial-element #xA5))
          (ok (equal src-hash (file-hash src)) "the source's content is unchanged")
          (ok (not (equal src-hash (file-hash dst))) "the clone changed")
          (ok (equalp (subseq (read-octets src) (* 5 1024 1024) (+ (* 5 1024 1024) 4096))
                      (subseq (pseudo-random-octets +big-size+ 7) (* 5 1024 1024) (+ (* 5 1024 1024) 4096)))
              "the source's octets at the written range")
          (ok (not (file-extents-shared-p dst)) "the rewritten range is no longer shared"))
        (testing "empty file"
          (let ((e (native (put root "src/empty" "")))
                (ed (native (sub root "clone/empty"))))
            (ok (eq t (ficlone-file fs e ed)))
            (ok (eql 0 (with-open-file (s ed) (file-length s))))
            (ok (not (file-extents-shared-p ed)) "no extent: NIL")))))))

(defreflink ficlone-reflink-cross-volume (dir other)
  (let ((fs (local-fs)))
    (with-volume-scratch (root dir)
      (let ((src (native-dir (sub root "src" :directory t)))
            (file (native (put root "src/a.txt" "alpha"))))
        (testing "reflink volume → the temp directory"
          (with-scratch (tmp)
            (ok (equal '(nil :cross-volume)
                       (multiple-value-list (ficlone-available-p fs src (native-dir tmp))))
                (format nil "→ ~A" (volume-type (native-dir tmp))))
            (ok (equal '(nil :cross-volume)
                       (multiple-value-list (ficlone-file fs file (native (sub tmp "a.txt"))))))
            (ok (not (probe-file (native (sub tmp "a.txt")))) "EXDEV: destination unlinked")
            (ok (null (probe-leftovers (native-dir tmp))))))
        (testing "reflink volume → the other reflink volume"
          (if (null other)
              (if (require-reflink-p)
                  (fail "the reflink job needs two reflink directories (btrfs and XFS)")
                  (skip "one reflink directory: no second volume"))
              (with-volume-scratch (far other)
                (ok (equal '(nil :cross-volume)
                           (multiple-value-list (ficlone-available-p fs src (native-dir far))))
                    (format nil "~A → ~A" (volume-type dir) (volume-type other)))
                (ok (equal '(nil :cross-volume)
                           (multiple-value-list (ficlone-file fs file (native (sub far "a.txt"))))))
                (ok (not (probe-file (native (sub far "a.txt")))))
                (let ((r (pathlib:fs-clone-tree fs src (native-dir (sub far "dst" :directory t)))))
                  (ok (eq :copy (pathlib:clone-report-mechanism r)))
                  (ok (eq :cross-volume (pathlib:clone-report-reason r)))
                  (ok (equal "alpha" (pathlib:read-text (sub far "dst/a.txt"))))))))))))

(deftest ficlone-reflink-btrfs-nocow
  ;; btrfs: a NOCOW (chattr +C) source against a COW destination is EINVAL:
  ;; (NIL :CLONE-FAILED) per file, and pathlib copies that one file.
  (let ((btrfs nil))
    (call-with-reflink-dirs
     (lambda (dir other)
       (declare (ignore other))
       (when (equal "btrfs" (volume-type dir))
         (setf btrfs t)
         (let ((fs (local-fs)))
           (with-volume-scratch (root dir)
             (put root "src/a.txt" "alpha")
             (put root "src/sub/b.txt" "beta")
             (let ((nocow (native (sub root "src/nocow.bin"))))
               (sh root "touch src/nocow.bin && chattr +C src/nocow.bin && head -c 65536 /dev/urandom > src/nocow.bin")
               (ok (search "C" (first (uiop:split-string (sh root "lsattr src/nocow.bin"))))
                   "the source is NOCOW")
               (ok (equal '(nil :clone-failed)
                          (multiple-value-list (ficlone-file fs nocow (native (sub root "one.bin"))))))
               (ok (not (probe-file (native (sub root "one.bin")))) "destination unlinked")
               (let ((r (pathlib:fs-clone-tree fs (sub root "src" :directory t) (sub root "dst" :directory t)
                                               :mechanism :ficlone)))
                 (ok (eq :ficlone (pathlib:clone-report-mechanism r)))
                 (ok (equal '(("nocow.bin" . :clone-failed)) (pathlib:clone-report-fallbacks r)))
                 (ok (eql 2 (pathlib:clone-report-cloned r)))
                 (ok (eql 1 (pathlib:clone-report-copied r)))
                 (ok (equal (file-hash nocow) (file-hash (native (sub root "dst/nocow.bin"))))
                     "the tree is still whole")
                 (ok (file-extents-shared-p (native (sub root "dst/sub/b.txt")))
                     "the other files are reflinked"))))))))
    (when (and (linux-p) (reflink-dir-strings) (not btrfs))
      (if (require-reflink-p)
          (fail "the reflink job needs a btrfs directory in FS_BACKEND_LINUX_REFLINK_DIRS")
          (skip "no btrfs directory among the reflink directories")))))

(defreflink ficlone-reflink-area (dir)
  ;; open-area (default :auto) on a reflink volume clones with :ficlone.
  (with-volume-scratch (root dir)
    (put root "base/a.txt" "alpha")
    (make-big-file root "base/big.bin")
    (let ((area (pathlib:open-area (sub root "base" :directory t)
                                   :directory (sub root "area" :directory t))))
      (unwind-protect
           (let ((r (pathlib:area-clone-report area)))
             (ok (eq :clone (pathlib:area-mechanism area)))
             (ok (eq :ficlone (pathlib:clone-report-mechanism r)))
             (ok (null (pathlib:clone-report-reason r)))
             (ok (eql 2 (pathlib:clone-report-cloned r)))
             (ok (file-extents-shared-p (native (sub root "area/big.bin"))))
             (ok (null (pathlib:fs-area-changes area)) "a fresh area has no changes"))
        (pathlib:close-area area)))))
